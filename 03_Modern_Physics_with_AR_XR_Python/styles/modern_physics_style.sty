\definecolor{rbruLightBg}{HTML}{F8FAFC}
\definecolor{codeBackground}{HTML}{0F172A}
\definecolor{slateGrey}{HTML}{4A5568}

% 5. Chapter & Section Formatting
\RequirePackage[most]{tcolorbox}
\RequirePackage{titlesec}

% Cyber-Modern Chapter Banner Box with Spacetime & Quantum Motifs
\newtcolorbox{chapterbannerbox}{
    enhanced,
    width=\textwidth,
    arc=6pt,
    boxrule=1pt,
    colframe=darkNavy!90!black,
    interior style={left color=darkNavy!98!black, right color=darkNavy!85!neonPurple},
    colback=darkNavy,
    borderline east={4pt}{0pt}{quantumGold},
    top=16pt, bottom=16pt, left=16pt, right=20pt,
    drop shadow=black!15,
    underlay={
        \begin{tcbclipinterior}
            \begin{scope}[opacity=0.20]
                % Spacetime Light Cone & Coordinate Grid
                \draw[cyan!60!white, line width=0.5pt, step=0.6cm] (0.2, 0.2) grid (6.8, 5.5);
                % 4D Spacetime Axes
                \draw[-{Stealth[scale=1.1]}, white, line width=1.4pt] (1.0, 0.8) -- (4.8, 0.8) node[right, font=\scriptsize\bfseries\color{white}] {$x$};
                \draw[-{Stealth[scale=1.1]}, white, line width=1.4pt] (1.0, 0.8) -- (1.0, 4.0) node[above, font=\scriptsize\bfseries\color{white}] {$ct$};
                % Relativistic Light Cone Lines (x = +/- ct)
                \draw[quantumGold, line width=1.3pt, dashed] (1.0, 0.8) -- (4.0, 3.8);
                \draw[quantumGold, line width=1.3pt, dashed] (1.0, 0.8) -- (-0.5, 2.3);
                % Quantum Wavefunction / De Broglie Harmonic Packet
                \draw[cyan, line width=1.5pt, domain=0.4:6.8, samples=100] 
                    plot (\x, {2.2 + 0.8*sin(3.5*\x r) * exp(-0.12*(\x-3.4)*(\x-3.4))});
                % Orbital Electron Cloud Shell
                \draw[rotate around={30:(3.4,2.2)}, neonPurple!80!white, line width=1.0pt, dashdotted] 
                    (3.4,2.2) ellipse (2.8cm and 1.1cm);
                \draw[rotate around={-40:(3.4,2.2)}, emeraldGlow, line width=0.9pt] 
                    (3.4,2.2) ellipse (2.4cm and 0.8cm);
            \end{scope}
        \end{tcbclipinterior}
    }
}

\newcommand{\rbruchapterbanner}[1]{%
    \begin{chapterbannerbox}
        \raggedleft
        {\fontsize{44}{50}\selectfont\bfseries\color{white} \chaptertitlename\ \thechapter\par}
        \vspace{6pt}
        {\color{quantumGold}\rule{0.50\textwidth}{2pt}\par}
        \vspace{6pt}
        {\fontsize{25}{31}\selectfont\bfseries\color{white} #1\par}
    \end{chapterbannerbox}
}

\newcommand{\rbruunnumberedchapterbanner}[1]{%
    \begin{chapterbannerbox}
        \raggedleft
        \vspace{4pt}
        {\fontsize{29}{35}\selectfont\bfseries\color{white} #1\par}
        \vspace{4pt}
    \end{chapterbannerbox}
}

\titleformat{\chapter}[block]
  {\normalfont}
  {}
  {0pt}
  {\rbruchapterbanner}

\titleformat{name=\chapter,numberless}[block]
  {\normalfont}
  {}
  {0pt}
  {\rbruunnumberedchapterbanner}

\titlespacing*{\chapter}{0pt}{0pt}{22pt}

\titleformat{\section}
  {\normalfont\fontsize{16}{20}\bfseries\color{darkNavy}}
  {\thesection}
  {1em}
  {}

\titleformat{\subsection}
  {\normalfont\fontsize{14}{18}\bfseries\color{cyberBlue}}
  {\thesubsection}
  {0.8em}
  {}

\titleformat{\subsubsection}
  {\normalfont\fontsize{12}{15}\bfseries\color{neonPurple}}
  {\thesubsubsection}
  {0.6em}
  {}

