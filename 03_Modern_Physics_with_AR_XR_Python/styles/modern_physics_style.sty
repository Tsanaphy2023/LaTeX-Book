% 7. Python Scientific Code Listings
\RequirePackage{listings}
\lstdefinestyle{modernpython}{
    language=Python,
    backgroundcolor=\color{codeBackground},
    basicstyle=\ttfamily\footnotesize\color{white},
    keywordstyle=\color{cyan}\bfseries,
    stringstyle=\color{quantumGold},
    commentstyle=\color{green!60!white}\itshape,
    numberstyle=\tiny\color{gray},
    numbers=left,
    stepnumber=1,
    numbersep=6pt,
    frame=single,
    rulecolor=\color{gray!30},
    breaklines=true,
    breakatwhitespace=false,
    showspaces=false,
    showstringspaces=false,
    tabsize=4
}
\lstset{style=modernpython}

% Python simulation tcolorbox
\newtcblisting{pythonbox}[1][การจำลองเชิงคำนวณด้วย Python (Python Engine)]{
    enhanced,
    breakable,
    colback=codeBackground,
    colframe=neonPurple,
    coltitle=white,
    fonttitle=\bfseries\small,
    title={#1},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=3.5mm,
    pad at break=2mm,
    listing only,
    listing options={
        style=modernpython
    }
}

