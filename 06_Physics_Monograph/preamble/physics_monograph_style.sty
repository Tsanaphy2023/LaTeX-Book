\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble/physics_monograph_style}[2026/09/05 RBRU University Physics Monograph Style]

% =========================================================================
% 1. Page Geometry (RBRU Standard: Left/Top 1.5in, Right/Bottom 1.0in)
% =========================================================================
\RequirePackage{geometry}
\geometry{
    a4paper,
    inner=1.5in,
    top=1.5in,
    outer=1.0in,
    bottom=1.0in,
    headheight=18pt,
    headsep=12pt,
    footskip=24pt
}

% =========================================================================
% 2. Indentation & Typography (RBRU 1 Tab = 1.25cm)
% =========================================================================
\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}

% =========================================================================
% 3. Core Packages
% =========================================================================
\RequirePackage{amsmath,amssymb,amsfonts}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc,shapes,arrows.meta,shadows,positioning,fadings}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage{caption}
\RequirePackage{hyperref}

% =========================================================================
% 4. Color Palette (Royal Physics & Monograph Theme)
% =========================================================================
\definecolor{physicsnavy}{HTML}{0A192F}
\definecolor{physicsblue}{HTML}{1E3A8A}
\definecolor{quantumcyan}{HTML}{0284C7}
\definecolor{goldamber}{HTML}{D97706}
\definecolor{darkslate}{HTML}{0F172A}
\definecolor{crimsonred}{HTML}{B91C1C}
\definecolor{cardbg}{HTML}{F8FAFC}
\definecolor{cardborder}{HTML}{CBD5E1}

% =========================================================================
% 5. Section & Chapter Formatting (RBRU Alignment)
% =========================================================================
\titleformat{\chapter}[display]
{\normalfont\bfseries\color{physicsblue}}
{\raggedright\Large\textbf{บทที่ \thechapter}}
{8pt}
{\Huge\bfseries\color{physicsnavy}}[\vspace{6pt}\titlerule\vspace{12pt}]

\titlespacing*{\chapter}{0pt}{0pt}{20pt}

\titleformat{\section}
{\normalfont\Large\bfseries\color{physicsblue}}
{\makebox[1.25cm][l]{\thesection}}
{0pt}
{}

\titleformat{\subsection}
{\normalfont\large\bfseries\color{physicsnavy}}
{\makebox[1.25cm][l]{\thesubsection}}
{0pt}
{}

\titleformat{\subsubsection}
{\normalfont\normalsize\bfseries\color{physicsnavy}}
{\makebox[1.25cm][l]{\thesubsubsection}}
{0pt}
{}

\titlespacing*{\section}{0pt}{14pt}{8pt}
\titlespacing*{\subsection}{0pt}{10pt}{6pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{4pt}

% =========================================================================
% 6. Running Headers & Footers
% =========================================================================
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\color{gray}\textsf{\thepage\quad\textbar\quad เอกสารคำสอนและคู่มือวิจัยฟิสิกส์ระดับมหาวิทยาลัย}}
\fancyhead[RO]{\small\color{gray}\textsf{\leftmark\quad\textbar\quad\thepage}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{cardborder}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\chaptermark}[1]{\markboth{บทที่ \thechapter\ #1}{}}

\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[C]{\small\thepage}
    \renewcommand{\headrulewidth}{0pt}
}

% =========================================================================
% 7. Serway/Tipler Specialized Environments
% =========================================================================
% P-S-C-T Worked Example Box (Tipler & Mosca Style)
\newtcolorbox{psctexample}[2]{
    enhanced,
    breakable,
    colback=quantumcyan!5,
    colframe=physicsblue,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title={\small\textbf{ตัวอย่างที่ #1 \enspace\textbar\enspace #2}},
    boxrule=1pt,
    arc=4pt,
    leftrule=5mm,
    top=8pt,
    bottom=8pt,
    left=12pt,
    right=12pt,
    boxsep=0pt,
    before skip=12pt,
    after skip=12pt
}

