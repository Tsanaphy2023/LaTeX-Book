% Author Research Integration Box
\newtcolorbox{researchbox}[1]{
    enhanced,
    breakable,
    colback=purple!5,
    colframe=purple!80,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title={\small\textbf{การบูรณาการงานวิจัยและฟิสิกส์เชิงคำนวณ \enspace\textbar\enspace #1}},
    boxrule=0.8pt,
    arc=3pt,
    leftrule=4mm,
    top=8pt,
    bottom=8pt,
    left=10pt,
    right=10pt,
    boxsep=0pt,
    before skip=10pt,
    after skip=10pt
}

% =========================================================================
% 8. Listings Setting for Python / SciML Code
% =========================================================================
\lstset{
    basicstyle=\small\ttfamily,
    numbers=left,
    numberstyle=\tiny\color{gray},
    stepnumber=1,
    numbersep=8pt,
    showstringspaces=false,
    breaklines=true,
    frame=none,
    keywordstyle=\color{physicsblue}\bfseries,
    commentstyle=\color{gray}\itshape,
    stringstyle=\color{goldamber},
    tabsize=4
}

% =========================================================================
% 9. Table & Captions Setting
% =========================================================================
\newcolumntype{Y}{>{\centering\arraybackslash}X}
\captionsetup[table]{position=top, skip=6pt, labelfont={bf}, textfont={normalfont}}
\captionsetup[figure]{position=bottom, skip=6pt, labelfont={bf}, textfont={normalfont}}

\endinput
