\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/general_physics_style}[2026/09/05 RBRU Fundamental Physics for Life Sciences Style Standard]

% ============================================================
% 1. Page Geometry (มาตรฐาน มรภ.รำไพพรรณี)
% ============================================================
\RequirePackage{geometry}
\geometry{
    a4paper,
    top=1.5in,
    bottom=1.0in,
    left=1.5in,
    right=1.0in,
    headheight=38pt,
    headsep=14pt,
    footskip=0.5in
}

% 1.1 Thai Linebreak & Hyphenation for XeLaTeX
\XeTeXlinebreaklocale "th"
\XeTeXlinebreakskip = 0pt plus 2pt minus 0.5pt
\setlength{\emergencystretch}{2.5em}

% 1.2 Paragraph Indentation (มาตรฐาน มรภ.รำไพพรรณี: 1 Tab = 1.25cm)
\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{6pt plus 2pt minus 1pt}

% 1.3 Thai Academic Terminology
\renewcommand{\chaptername}{บทที่}
\renewcommand{\figurename}{ภาพที่}
\renewcommand{\tablename}{ตารางที่}
\renewcommand{\contentsname}{สารบัญ}
\renewcommand{\listfigurename}{สารบัญภาพ}
\renewcommand{\listtablename}{สารบัญตาราง}
\renewcommand{\appendixname}{ภาคผนวก}
\renewcommand{\bibname}{บรรณานุกรม}
\renewcommand{\indexname}{ดัชนีสืบค้นคำสำคัญ}

% ============================================================
% 2. Math & Science Packages
% ============================================================
\RequirePackage{amsmath,amssymb,amsfonts,mathtools}
\RequirePackage{bm}
\RequirePackage{siunitx}

% ============================================================
% 3. Graphics, Tables, & Floats
% ============================================================
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{multirow}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}

\RequirePackage{caption}
\DeclareCaptionLabelSeparator{thaisep}{\quad}
\captionsetup{labelsep=thaisep}
\captionsetup[table]{position=top, skip=6pt, labelfont={bf,color=physRoyalBlue}, textfont={normalfont}, labelsep=thaisep}
\captionsetup[figure]{position=bottom, skip=8pt, labelfont={bf,color=physRoyalBlue}, textfont={normalfont}, labelsep=thaisep}

% ============================================================
% 4. Color Palette (Physics & Life Sciences Masterclass)
% ============================================================
\RequirePackage[table,xcdraw]{xcolor}
\definecolor{physRoyalBlue}{HTML}{1E3A8A}
\definecolor{physCyan}{HTML}{0284C7}
\definecolor{physAmber}{HTML}{D97706}
\definecolor{bioEmerald}{HTML}{059669}
\definecolor{physSlate}{HTML}{334155}
\definecolor{charcoal}{HTML}{0F172A}
\definecolor{softSmoke}{HTML}{F8FAFC}
\definecolor{crimsonNote}{HTML}{BE123C}

% ============================================================
% 5. TikZ & Vector Graphics
% ============================================================
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, calc, shadows, backgrounds, fit, patterns, decorations.pathmorphing}

% ============================================================
% 6. Custom Highlight Boxes (tcolorbox)
% ============================================================
\RequirePackage[most]{tcolorbox}

% 6.1 Concept Box (มโนทัศน์ฟิสิกส์พื้นฐาน)
\newtcolorbox{conceptbox}[1][]{
    enhanced,
    colback=softSmoke,
    colframe=physRoyalBlue,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title=หลักการและมโนทัศน์สำคัญ (Key Concept),
    arc=3mm,
    boxrule=1.2pt,
    leftrule=5mm,
    drop shadow={black!15},
    before skip=12pt,
    after skip=12pt,
    #1
}

% 6.2 Worked Example Box (โจทย์ตัวอย่างและการวิเคราะห์เชิงฟิสิกส์)
\newtcolorbox{examplebox}[1][]{
    enhanced,
    colback=white,
    colframe=physCyan,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title=ตัวอย่างโจทย์และการวิเคราะห์ (Worked Example),
    arc=3mm,
    boxrule=1.2pt,
    leftrule=5mm,
    drop shadow={black!15},
    before skip=12pt,
    after skip=12pt,
    #1
}

% 6.3 Life Sciences Application Box (การประยุกต์ในวิทยาศาสตร์ชีวภาพและสิ่งแวดล้อม)
\newtcolorbox{bioappbox}[1][]{
    enhanced,
    colback=softSmoke,
    colframe=bioEmerald,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title=การประยุกต์ในวิทยาศาสตร์ชีวภาพและสิ่งแวดล้อม (Life Sciences Application),
    arc=3mm,
    boxrule=1.2pt,
    leftrule=5mm,
    drop shadow={black!15},
    before skip=12pt,
    after skip=12pt,
    #1
}

% 6.4 Lab Protocol & Measurement Box (คู่มือปฏิบัติการและการวัดละเอียด)
\newtcolorbox{labbox}[1][]{
    enhanced,
    colback=softSmoke,
    colframe=physAmber,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title=ข้อควรระวังและทักษะการวัดละเอียดในห้องปฏิบัติการ (Precision Lab Skills),
    arc=3mm,
    boxrule=1.2pt,
    leftrule=5mm,
    drop shadow={black!15},
    before skip=12pt,
    after skip=12pt,
    #1
}

% 6.5 Warning & Error Analysis Box
\newtcolorbox{warningbox}[1][]{
    enhanced,
    colback=white,
    colframe=crimsonNote,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title=ข้อผิดพลาดที่พบบ่อยและการวิเคราะห์ความคลาดเคลื่อน (Common Errors),
    arc=3mm,
    boxrule=1.2pt,
    leftrule=5mm,
    drop shadow={black!15},
    before skip=12pt,
    after skip=12pt,
    #1
}

% ============================================================
% 7. Section & Chapter Headings Styling (RBRU Standards)
% ============================================================
\RequirePackage{titlesec}

% Chapter Format (Modern Masterclass style with Royal Blue banner)
\titleformat{\chapter}[display]
{\normalfont\huge\bfseries\color{physRoyalBlue}}
{\filleft\fontsize{16pt}{20pt}\selectfont\color{physAmber}\bfseries\chaptername\ \fontsize{40pt}{44pt}\selectfont\thechapter}
{1ex}
{\titlerule[2pt]\vspace{1.5ex}\filright}
[\vspace{1.5ex}\titlerule]

% Section formatting: 1 Tab = 1.25cm alignment for section numbering
\titleformat{\section}
{\normalfont\Large\bfseries\color{physRoyalBlue}}
{\makebox[1.25cm][l]{\thesection}}
{0pt}
{}

\titleformat{\subsection}
{\normalfont\large\bfseries\color{physSlate}}
{\makebox[1.25cm][l]{\thesubsection}}
{0pt}
{}

\titleformat{\subsubsection}
{\normalfont\normalsize\bfseries\color{physCyan}}
{\makebox[1.25cm][l]{\thesubsubsection}}
{0pt}
{}

% ============================================================
% 8. Header & Footer (fancyhdr)
% ============================================================
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{physSlate}\nouppercase{\leftmark}}
\fancyhead[R]{\small\bfseries\color{physRoyalBlue}\thepage}
\fancyfoot[C]{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0pt}

% Plain page style for chapter first page
\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[C]{\small\bfseries\color{physRoyalBlue}\thepage}
    \renewcommand{\headrulewidth}{0pt}
}

% ============================================================
% 9. Table of Contents & Lists (tocloft)
% ============================================================
\RequirePackage{tocloft}
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftfigleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cfttableader}{\cftdotfill{\cftdotsep}}

% ============================================================
% 10. Indexing & Bibliography
% ============================================================
\RequirePackage{makeidx}
\makeindex

\endinput
