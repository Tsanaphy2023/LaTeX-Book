\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/rbru_book_style_en}[2026/09/04 RBRU Academic Textbook & Physics Layout Standard Style (English Edition)]

% 1. Page Geometry (Academic Standard: Inside 1.25in, Outside 1.0in, Top 1.25in, Bottom 1.0in)
\RequirePackage{geometry}
\geometry{
    a4paper,
    top=1.25in,
    bottom=1.0in,
    left=1.25in,
    right=1.0in,
    headheight=36pt,
    headsep=14pt,
    footskip=0.5in
}

% 2. Math & Science Packages (Physics Textbook Architect)
\RequirePackage{amsmath,amssymb,amsfonts,mathtools}
\allowdisplaybreaks   % Allow long equation arrays to break across pages
\RequirePackage{bm}
\RequirePackage{siunitx}
\RequirePackage{physics}
\RequirePackage{esint}
\RequirePackage{microtype}

% Typography: prevent overfull hboxes in mixed math-text paragraphs
\setlength{\emergencystretch}{2.5em}

% 3. Graphics, TikZ, Tables & Floats
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{colortbl}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}
\RequirePackage{caption}
\captionsetup{labelsep=colon}
\captionsetup[table]{position=top, skip=6pt, labelfont={bf,color=rbruNavy}, textfont={bf}}
\captionsetup[figure]{position=bottom, skip=8pt, labelfont={bf,color=rbruNavy}, textfont={bf}}

% 3.1 Indexing System (Subject Index)
\RequirePackage{imakeidx}
\makeindex[columns=2, title=Subject Index, intoc]

\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows.meta,positioning,calc,patterns,decorations.pathmorphing}

% 4. Color Palette (RBRU Identity & Physics Vector Color Coding)
\RequirePackage{xcolor}
\definecolor{rbruGreen}{HTML}{0D5C3A}
\definecolor{rbruNavy}{HTML}{1A365D}
\definecolor{rbruGold}{HTML}{D97706}
\definecolor{rbruSlate}{HTML}{334155}
\definecolor{slateGrey}{HTML}{4A5568}
\definecolor{rbruLightBg}{HTML}{F8FAFC}
\definecolor{rbruCodeBg}{HTML}{F1F5F9}

% Standard Physics Vector Color Palette
\definecolor{physForce}{HTML}{E53E3E}        % Red: Force
\definecolor{physVelocity}{HTML}{3182CE}     % Blue: Velocity
\definecolor{physAccel}{HTML}{DD6B20}        % Orange: Acceleration
\definecolor{physDisplace}{HTML}{38A169}     % Green: Displacement / Position
\definecolor{physGeneric}{HTML}{2D3748}      % Dark Slate: Axes & Generic vectors

% 5. Section & Chapter Formatting
\RequirePackage[most]{tcolorbox}
\RequirePackage{titlesec}

% Chapter Banner Box with Physics Vector Illustration
\newtcolorbox{chapterbannerbox}{
    enhanced,
    width=\textwidth,
    arc=6pt,
    boxrule=1pt,
    colframe=rbruNavy!85!black,
    interior style={left color=rbruNavy!98!black, right color=rbruNavy!85!rbruSlate},
    colback=rbruNavy,
    borderline east={4pt}{0pt}{rbruGold},
    top=16pt, bottom=16pt, left=16pt, right=20pt,
    drop shadow=black!10,
    underlay={
        \begin{tcbclipinterior}
            \begin{scope}[opacity=0.22]
                % Coordinate Grid
                \draw[cyan!50!white, line width=0.5pt, step=0.7cm] (0.2, 0.2) grid (6.5, 5.5);
                % 3D Coordinate Axes
                \draw[-{Stealth[scale=1.1]}, white, line width=1.4pt] (1.1, 0.8) -- (4.6, 0.8) node[right, font=\scriptsize\bfseries\color{white}] {$x$};
                \draw[-{Stealth[scale=1.1]}, white, line width=1.4pt] (1.1, 0.8) -- (1.1, 3.8) node[above, font=\scriptsize\bfseries\color{white}] {$z$};
                \draw[-{Stealth[scale=1.1]}, white, line width=1.4pt] (1.1, 0.8) -- (0.2, 0.2) node[below left, font=\scriptsize\bfseries\color{white}] {$y$};
                % Physics Vectors
                \draw[-{Stealth[scale=1.2]}, physForce, line width=1.7pt] (1.1, 0.8) -- (3.8, 2.9) node[above left, font=\small\bfseries\color{physForce}] {$\vec{F}$};
                \draw[-{Stealth[scale=1.0]}, physVelocity, line width=1.3pt] (1.1, 0.8) -- (3.0, 1.2) node[below right, font=\footnotesize\bfseries\color{physVelocity}] {$\vec{v}$};
                \draw[-{Stealth[scale=1.0]}, physDisplace, line width=1.3pt] (1.1, 0.8) -- (1.9, 3.2) node[above right, font=\footnotesize\bfseries\color{physDisplace}] {$\vec{r}$};
                % Wave Packet Oscillation
                \draw[rbruGold, line width=1.4pt, domain=0.4:6.8, samples=80] 
                    plot (\x, {1.9 + 0.7*sin(3.0*\x r) * exp(-0.10*(\x-3.4)*(\x-3.4))});
                % Orbital Trajectory
                \draw[rotate around={22:(3.4,1.9)}, white, line width=0.8pt, dashdotdotted] 
                    (3.4,1.9) ellipse (2.6cm and 0.95cm);
            \end{scope}
        \end{tcbclipinterior}
    }
}

\newcommand{\rbruchapterbanner}[1]{%
    \begin{chapterbannerbox}
        \raggedleft
        {\fontsize{44}{50}\selectfont\bfseries\color{white} Chapter\ \thechapter\par}
        \vspace{6pt}
        {\color{rbruGold}\rule{0.50\textwidth}{2pt}\par}
        \vspace{6pt}
        {\fontsize{25}{31}\selectfont\bfseries\color{white} #1\par}
    \end{chapterbannerbox}
}

\newcommand{\rbruunnumberedchapterbanner}[1]{%
    \begin{chapterbannerbox}
        \raggedleft
        \vspace{4pt}
        {\fontsize{29}{35}\selectfont\bfseries\color{white} #1\par}
        \vspace{4pt}
    \end{chapterbannerbox}
}

\titleformat{\chapter}[block]
  {\normalfont}
  {}
  {0pt}
  {\rbruchapterbanner}

\titleformat{name=\chapter,numberless}[block]
  {\normalfont}
  {}
  {0pt}
  {\rbruunnumberedchapterbanner}

\titlespacing*{\chapter}{0pt}{0pt}{22pt}

\titleformat{\section}
  {\normalfont\fontsize{16}{20}\bfseries\color{rbruNavy}}
  {\thesection}
  {1em}
  {}

\titleformat{\subsection}
  {\normalfont\fontsize{14}{18}\bfseries\color{rbruGreen}}
  {\thesubsection}
  {0.8em}
  {}

\titleformat{\subsubsection}
  {\normalfont\fontsize{12}{15}\bfseries\color{rbruSlate}}
  {\thesubsubsection}
  {0.6em}
  {}

% 6. Academic Boxes (tcolorbox)

% Learning Objectives Box (OBE Bloom's Taxonomy)
\newtcolorbox{chapterobjectives}[1][Chapter Learning Objectives]{
    enhanced,
    colback=rbruLightBg,
    colframe=rbruNavy,
    fonttitle=\bfseries,
    title=#1,
    arc=2.5mm,
    boxrule=1pt,
    leftrule=4.5mm,
    drop shadow=black!8
}

% Definition Box
\newtcolorbox[auto counter, number within=chapter]{mathdefinition}[1][]{
    enhanced,
    colback=rbruLightBg,
    colframe=rbruGreen,
    fonttitle=\bfseries,
    title=Definition~\thetcbcounter\ #1,
    arc=3mm,
    boxrule=1.2pt,
    leftrule=5mm,
    drop shadow=black!10
}

% Theorem Box
\newtcolorbox[auto counter, number within=chapter]{maththeorem}[1][]{
    enhanced,
    colback=white,
    colframe=rbruNavy,
    fonttitle=\bfseries,
    title=Theorem~\thetcbcounter\ #1,
    arc=2mm,
    boxrule=1pt,
    leftrule=4mm,
    drop shadow=black!10
}

% P-S-C-T Worked Example Box (Tipler & Mosca Standard)
\newtcolorbox[auto counter, number within=chapter]{psctexample}[1][]{
    enhanced,
    breakable,
    colback=white,
    colframe=rbruGold,
    fonttitle=\bfseries,
    title=Example~\thetcbcounter: #1,
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm,
    pad at break=2mm
}

% Pitfall Box (Red Accent)
\newtcolorbox{pitfallbox}[1][Common Pitfall]{
    enhanced,
    colback=red!5!white,
    colframe=red!75!black,
    fonttitle=\bfseries,
    title=\textbf{Pitfall Alert:} #1,
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm
}

% Concept Check Box (Teal Accent)
\newtcolorbox{conceptcheck}[1][Concept Check]{
    enhanced,
    colback=teal!5!white,
    colframe=teal!75!black,
    fonttitle=\bfseries,
    title=\textbf{Active Learning:} #1,
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm
}

% Physics in the Real World Box (Green Accent)
\newtcolorbox{physicsconnection}[1][Physics Connection]{
    enhanced,
    colback=green!5!white,
    colframe=rbruGreen,
    fonttitle=\bfseries,
    title=\textbf{Physics Application:} #1,
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm
}

% QED symbol for examples
\newcommand{\qedexam}{\hfill\textcolor{rbruGold}{$\blacksquare$}}

% 7. Python Scientific Code Listings
\RequirePackage{listings}
\lstdefinestyle{pythonstyle}{
    backgroundcolor=\color{rbruCodeBg},
    commentstyle=\color{green!50!black}\itshape,
    keywordstyle=\color{blue}\bfseries,
    numberstyle=\tiny\color{gray},
    stringstyle=\color{purple},
    basicstyle=\ttfamily\small,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    frame=single,
    rulecolor=\color{gray!30}
}
\lstset{style=pythonstyle}

% Python simulation tcolorbox
\newtcblisting{pythonbox}[1][Numerical Simulation in Python]{
    enhanced,
    breakable,
    colback=rbruCodeBg,
    colframe=rbruNavy!85!black,
    coltitle=white,
    fonttitle=\bfseries\small,
    title={#1},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=3.5mm,
    pad at break=2mm,
    listing only,
    listing options={
        language=Python,
        basicstyle=\ttfamily\footnotesize,
        keywordstyle=\color{blue!80!black}\bfseries,
        commentstyle=\color{green!50!black}\itshape,
        stringstyle=\color{red!70!black},
        numbers=left,
        numberstyle=\tiny\color{gray},
        stepnumber=1,
        numbersep=6pt,
        breaklines=true,
        showstringspaces=false,
        tabsize=4
    }
}

% 8. Header and Footer (fancyhdr)
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\thepage}
\fancyhead[L]{\slshape \nouppercase{\leftmark}}
\renewcommand{\headrulewidth}{0.5pt}

\endinput
