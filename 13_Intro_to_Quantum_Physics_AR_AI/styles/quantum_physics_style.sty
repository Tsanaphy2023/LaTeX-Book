% Dynamic Chapter Motif based on \value{chapter}
\newcommand{\renderquantumchaptermotif}{%
    \ifcase\value{chapter}%
        % 0: Default
        \begin{scope}[opacity=0.22]
            \draw[qubitBlue!60!white, line width=0.5pt, step=0.6cm] (0.2, 0.2) grid (6.8, 5.2);
            \draw[quantumGold, line width=1.4pt, domain=0.8:6.4, samples=80] plot (\x, {2.2 + 0.9*sin(3.0*\x r)*exp(-0.1*(\x-3.2)*(\x-3.2))});
        \end{scope}
    \or% 1: Particle properties & Blackbody
        \begin{scope}[opacity=0.25]
            \draw[qubitBlue!50!white, step=0.5cm, line width=0.3pt] (0.2, 0.2) grid (6.8, 5.0);
            \draw[quantumGold, line width=1.6pt, domain=0.5:6.2, samples=60] plot (\x, {4.2 * ((\x/1.8)^3) / (exp(\x/1.8) - 1 + 0.05)});
            \node at (4.8, 4.2) [font=\tiny\bfseries\color{quantumGold}] {Planck Spectrum};
        \end{scope}
    \or% 2: Wave properties & Gaussian packet
        \begin{scope}[opacity=0.25]
            \draw[emeraldGlow!50!white, step=0.5cm, line width=0.3pt] (0.2, 0.2) grid (6.8, 5.0);
            \draw[qubitBlue, line width=1.4pt, domain=0.5:6.5, samples=90] plot (\x, {2.4 + 1.8*exp(-0.8*(\x-3.5)*(\x-3.5))*cos(12*(\x-3.5) r)});
            \node at (4.8, 4.3) [font=\tiny\bfseries\color{qubitBlue}] {$\Delta x \Delta p \ge \hbar/2$};
        \end{scope}
    \or% 3: Schrödinger & Dirac Notation
        \begin{scope}[opacity=0.25]
            \draw[neonPurple!50!white, step=0.5cm, line width=0.3pt] (0.2, 0.2) grid (6.8, 5.0);
            \node at (3.5, 2.5) [font=\large\bfseries\color{neonPurple!80!white}] {$i\hbar\frac{\partial}{\partial t}\ket{\Psi} = \hat{H}\ket{\Psi}$};
        \end{scope}
    \or% 4: Quantum Tunneling & STM
        \begin{scope}[opacity=0.25]
            \draw[qubitBlue!50!white, step=0.5cm, line width=0.3pt] (0.2, 0.2) grid (6.8, 5.0);
            \draw[white, line width=2pt] (2.8, 0.5) -- (2.8, 4.0) -- (4.2, 4.0) -- (4.2, 0.5);
            \draw[quantumGold, line width=1.4pt, domain=0.5:2.8, samples=40] plot (\x, {2.2 + 0.8*sin(6*\x r)});
            \draw[quantumGold, line width=1.4pt, domain=2.8:4.2, samples=30] plot (\x, {2.2 + 0.8*exp(-1.5*(\x-2.8))});
            \draw[quantumGold, line width=1.4pt, domain=4.2:6.5, samples=40] plot (\x, {2.2 + 0.3*sin(6*(\x-4.2) r)});
            \node at (3.5, 4.4) [font=\tiny\bfseries\color{white}] {Barrier $V_0$};
        \end{scope}
    \or% 5: Harmonic Oscillator
        \begin{scope}[opacity=0.25]
            \draw[quantumGold!50!white, step=0.5cm, line width=0.3pt] (0.2, 0.2) grid (6.8, 5.0);
            \draw[qubitBlue, line width=1.5pt, domain=1.0:6.0, samples=50] plot (\x, {0.6 + 0.3*(\x-3.5)*(\x-3.5)});
            \foreach \lvl in {1.0, 1.8, 2.6, 3.4} {
                \draw[emeraldGlow, line width=1.2pt] (2.2, \lvl) -- (4.8, \lvl);
            }
            \node at (5.2, 3.4) [font=\tiny\bfseries\color{emeraldGlow}] {$E_n = (n+\frac{1}{2})\hbar\omega$};
        \end{scope}
    \or% 6: Hydrogen Atom & Orbitals
        \begin{scope}[opacity=0.25]
            \draw[qubitBlue!50!white, step=0.5cm, line width=0.3pt] (0.2, 0.2) grid (6.8, 5.0);
            \fill[quantumGold] (3.5, 2.5) circle (3pt);
            \draw[qubitBlue, line width=1.2pt, dashed] (3.5, 2.5) circle (1.2cm);
            \draw[emeraldGlow, line width=1.2pt, dashed] (3.5, 2.5) circle (2.2cm);
            \draw[entanglePink, line width=1.2pt] (3.5, 2.5) ellipse (2.4cm and 0.9cm);
        \end{scope}
    \or% 7: Perturbation Theory & BEC
        \begin{scope}[opacity=0.25]
            \draw[neonPurple!50!white, step=0.5cm, line width=0.3pt] (0.2, 0.2) grid (6.8, 5.0);
            \draw[white, line width=1.2pt] (1.0, 2.5) -- (3.0, 2.5);
            \draw[-{Stealth}, white, line width=1.0pt] (3.0, 2.5) -- (4.5, 3.4);
            \draw[-{Stealth}, white, line width=1.0pt] (3.0, 2.5) -- (4.5, 1.6);
            \draw[quantumGold, line width=1.2pt] (4.5, 3.4) -- (6.2, 3.4);
            \draw[quantumGold, line width=1.2pt] (4.5, 1.6) -- (6.2, 1.6);
            \node at (5.3, 4.0) [font=\tiny\bfseries\color{quantumGold}] {Stark Splitting};
        \end{scope}
    \or% 8: Qubits & Bloch Sphere
        \begin{scope}[opacity=0.28]
            \draw[qubitBlue, line width=1.3pt] (3.5, 2.5) circle (1.8cm);
            \draw[qubitBlue!70!white, dashed, line width=0.8pt] (3.5, 2.5) ellipse (1.8cm and 0.6cm);
            \draw[-{Stealth}, white, line width=1.2pt] (3.5, 0.4) -- (3.5, 4.6) node[above, font=\tiny\bfseries\color{white}] {$\ket{0}$};
            \draw[-{Stealth}, white, line width=1.2pt] (1.4, 2.5) -- (5.6, 2.5) node[right, font=\tiny\bfseries\color{white}] {$\ket{+y}$};
            \draw[-{Stealth[scale=1.2]}, quantumGold, line width=1.8pt] (3.5, 2.5) -- (4.7, 3.7) node[above right, font=\tiny\bfseries\color{quantumGold}] {$\ket{\psi}$};
            \node at (3.5, 0.1) [font=\tiny\bfseries\color{white}] {$\ket{1}$};
        \end{scope}
    \or% 9: Quantum Entanglement & Teleportation
        \begin{scope}[opacity=0.28]
            \fill[qubitBlue] (1.8, 2.5) circle (4pt) node[below=4pt, font=\tiny\bfseries\color{qubitBlue}] {Alice};
            \fill[entanglePink] (5.2, 2.5) circle (4pt) node[below=4pt, font=\tiny\bfseries\color{entanglePink}] {Bob};
            \draw[quantumGold, line width=1.4pt, decoration={snake, amplitude=1.5mm, segment length=5mm}, decorate] (1.8, 2.5) -- (5.2, 2.5);
            \node at (3.5, 3.3) [font=\tiny\bfseries\color{quantumGold}] {$\frac{\ket{00}+\ket{11}}{\sqrt{2}}$};
        \end{scope}
    \or% 10: Quantum Algorithms & PINNs AI
        \begin{scope}[opacity=0.28]
            \draw[qubitBlue!50!white, step=0.5cm, line width=0.3pt] (0.2, 0.2) grid (6.8, 5.0);
            \node at (3.5, 3.8) [font=\small\bfseries\color{qubitBlue}] {Grover \& PINNs AI};
            \draw[emeraldGlow, line width=1.2pt] (1.2, 2.2) -- (2.0, 2.2) -- (2.0, 2.8) -- (2.8, 2.8) -- (2.8, 1.4) -- (4.2, 1.4) -- (4.2, 2.2) -- (5.8, 2.2);
            \node at (4.5, 1.0) [font=\tiny\bfseries\color{emeraldGlow}] {$\mathcal{L}_{\text{PINN}} = \|\hat{H}\psi - E\psi\|^2$};
        \end{scope}
    \else
        \begin{scope}[opacity=0.20]
            \draw[qubitBlue!50!white, step=0.6cm, line width=0.3pt] (0.2, 0.2) grid (6.8, 5.0);
        \end{scope}
    \fi
}

