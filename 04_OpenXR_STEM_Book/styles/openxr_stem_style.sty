% Dynamic Chapter Motif based on \value{chapter}
\newcommand{\renderchaptermotif}{%
    \ifcase\value{chapter}%
        % Case 0 / Frontmatter & Backmatter
        \begin{scope}[opacity=0.22]
            \draw[cyan!60!white, line width=0.5pt, step=0.6cm] (0.2, 0.2) grid (6.8, 5.2);
            \draw[-{Stealth[scale=1.1]}, white, line width=1.4pt] (0.8, 0.8) -- (5.2, 0.8) node[right, font=\scriptsize\bfseries\color{white}] {$x$};
            \draw[-{Stealth[scale=1.1]}, white, line width=1.4pt] (0.8, 0.8) -- (0.8, 4.2) node[above, font=\scriptsize\bfseries\color{white}] {$y$};
            \draw[amberGlow, line width=1.4pt, domain=0.8:6.4, samples=80] plot (\x, {2.2 + 0.9*sin(3.0*\x r)*exp(-0.1*(\x-3.2)*(\x-3.2))});
            \draw[emeraldActive, line width=1.0pt, dashed] (3.4, 2.2) circle (1.8cm);
            \draw[cyberPurple!80!white, line width=0.9pt] (3.4, 2.2) ellipse (2.5cm and 0.9cm);
        \end{scope}
    \or% Case 1: OpenXR Architecture & Spatial Foundations
        \begin{scope}[opacity=0.28]
            \draw[cyan!50!white, line width=0.4pt, step=0.5cm] (0.2, 0.2) grid (6.8, 5.0);
            \draw[openxrTeal, line width=1.2pt, fill=openxrTeal!20] (1.0, 3.8) rectangle (5.8, 4.6);
            \node[font=\scriptsize\bfseries\color{white}] at (3.4, 4.2) {OpenXR Application Layer};
            \draw[-{Stealth[scale=1.0]}, white, line width=1.2pt] (3.4, 3.8) -- (3.4, 3.2);
            \draw[spatialBlue, line width=1.2pt, fill=spatialBlue!20] (1.0, 2.4) rectangle (5.8, 3.2);
            \node[font=\scriptsize\bfseries\color{white}] at (3.4, 2.8) {OpenXR Loader / API Layer};
            \draw[-{Stealth[scale=1.0]}, white, line width=1.2pt] (3.4, 2.4) -- (3.4, 1.8);
            \draw[cyberPurple, line width=1.2pt, fill=cyberPurple!20] (1.0, 1.0) rectangle (5.8, 1.8);
            \node[font=\scriptsize\bfseries\color{white}] at (3.4, 1.4) {OpenXR Hardware Runtime Driver};
            \fill[amberGlow] (0.6, 4.2) circle (2.5pt);
            \fill[emeraldActive] (6.2, 1.4) circle (2.5pt);
        \end{scope}
    \or% Case 2: 3D Reference Spaces & 6DoF Tracking
        \begin{scope}[opacity=0.28]
            \draw[-{Stealth[scale=1.2]}, cyan, line width=1.5pt] (1.5, 1.5) -- (5.8, 1.5) node[right, font=\footnotesize\bfseries\color{cyan}] {$X$};
            \draw[-{Stealth[scale=1.2]}, emeraldActive, line width=1.5pt] (1.5, 1.5) -- (1.5, 4.8) node[above, font=\footnotesize\bfseries\color{emeraldActive}] {$Y$};
            \draw[-{Stealth[scale=1.2]}, amberGlow, line width=1.5pt] (1.5, 1.5) -- (0.4, 0.4) node[below left, font=\footnotesize\bfseries\color{amberGlow}] {$Z$};
            \draw[cyberPurple, line width=1.3pt] (3.6, 3.0) circle (1.2cm);
            \draw[-{Stealth[scale=1.0]}, cyberPurple, line width=1.3pt] (4.8, 3.0) arc (0:120:1.2cm);
            \draw[openxrTeal, line width=1.1pt, dashed] (3.6, 3.0) ellipse (1.6cm and 0.6cm);
            \draw[spatialBlue, line width=1.0pt] (3.1, 2.5) rectangle (4.1, 3.5);
            \draw[spatialBlue, line width=1.0pt] (3.1, 3.5) -- (3.5, 3.9) -- (4.5, 3.9) -- (4.1, 3.5);
            \draw[spatialBlue, line width=1.0pt] (4.5, 3.9) -- (4.5, 2.9) -- (4.1, 2.5);
        \end{scope}
    \or% Case 3: 21-Joint Skeletal Hand Tracking
        \begin{scope}[opacity=0.28]
            \fill[white] (3.4, 0.8) circle (3pt) node[below, font=\tiny\color{white}] {Wrist};
            \fill[openxrTeal] (3.4, 1.8) circle (2.5pt);
            \draw[white, line width=1.0pt] (3.4, 0.8) -- (3.4, 1.8);
            \fill[amberGlow] (2.2, 1.5) circle (2.2pt);
            \fill[amberGlow] (1.6, 2.0) circle (2.2pt);
            \fill[amberGlow] (1.2, 2.5) circle (2.2pt);
            \draw[amberGlow, line width=1.0pt] (3.4, 1.8) -- (2.2, 1.5) -- (1.6, 2.0) -- (1.2, 2.5);
            \fill[cyan] (2.6, 2.6) circle (2.2pt);
            \fill[cyan] (2.5, 3.4) circle (2.2pt);
            \fill[cyan] (2.4, 4.2) circle (2.2pt);
            \draw[cyan, line width=1.0pt] (3.4, 1.8) -- (2.6, 2.6) -- (2.5, 3.4) -- (2.4, 4.2);
            \fill[emeraldActive] (3.4, 2.8) circle (2.2pt);
            \fill[emeraldActive] (3.4, 3.7) circle (2.2pt);
            \fill[emeraldActive] (3.4, 4.5) circle (2.2pt);
            \draw[emeraldActive, line width=1.0pt] (3.4, 1.8) -- (3.4, 2.8) -- (3.4, 3.7) -- (3.4, 4.5);
            \fill[cyberPurple] (4.2, 2.6) circle (2.2pt);
            \fill[cyberPurple] (4.3, 3.4) circle (2.2pt);
            \fill[cyberPurple] (4.4, 4.1) circle (2.2pt);
            \draw[cyberPurple, line width=1.0pt] (3.4, 1.8) -- (4.2, 2.6) -- (4.3, 3.4) -- (4.4, 4.1);
            \fill[spatialBlue] (4.8, 2.2) circle (2.2pt);
            \fill[spatialBlue] (5.1, 2.9) circle (2.2pt);
            \fill[spatialBlue] (5.3, 3.5) circle (2.2pt);
            \draw[spatialBlue, line width=1.0pt] (3.4, 1.8) -- (4.8, 2.2) -- (5.1, 2.9) -- (5.3, 3.5);
            \draw[amberGlow, dashed, line width=1.0pt] (1.2, 2.5) -- (2.4, 4.2);
            \node[font=\tiny\bfseries\color{amberGlow}] at (1.8, 3.5) {Pinch};
        \end{scope}
    \or% Case 4: Physics Engine & STEM Simulation
        \begin{scope}[opacity=0.28]
            \foreach \x in {0.8, 2.0, 3.2, 4.4, 5.6} {
                \draw[-{Stealth[scale=0.8]}, cyan!70!white, line width=0.8pt] (\x, 4.8) -- (\x, 4.0);
            }
            \node[font=\scriptsize\color{cyan}] at (6.2, 4.4) {$\vec{g}$};
            \draw[white, line width=1.2pt] (1.0, 1.0) -- (6.0, 1.0);
            \draw[amberGlow, line width=1.3pt, fill=amberGlow!30] (1.5, 1.0) rectangle (2.7, 2.2);
            \draw[decoration={aspect=0.4, segment length=3mm, amplitude=3mm, coil}, decorate, spatialBlue, line width=1.2pt] (2.7, 1.6) -- (4.5, 1.6);
            \draw[emeraldActive, line width=1.3pt, fill=emeraldActive!30] (4.5, 1.0) rectangle (5.7, 2.2);
            \draw[-{Stealth[scale=1.1]}, cyberPurple, line width=1.4pt] (2.1, 2.2) -- (2.1, 3.2) node[above, font=\tiny\bfseries\color{white}] {$\vec{F}_{\text{norm}}$};
        \end{scope}
    \or% Case 5: Python & PyOpenXR Scientific Computing
        \begin{scope}[opacity=0.28]
            \draw[openxrTeal!60!white, line width=0.4pt, step=0.6cm] (0.4, 0.4) grid (6.4, 4.8);
            \draw[spatialBlue, line width=2.0pt] (2.2, 2.8) arc (90:270:0.9cm) -- (3.8, 1.0) arc (-90:90:0.9cm) -- cycle;
            \draw[amberGlow, line width=2.0pt] (4.2, 2.4) arc (-90:90:0.9cm) -- (2.6, 4.2) arc (90:270:0.9cm) -- cycle;
            \fill[white] (2.6, 3.3) circle (2pt);
            \fill[white] (3.8, 1.9) circle (2pt);
            \draw[emeraldActive, line width=1.3pt] (0.8, 1.5) -- (1.6, 2.2) -- (2.4, 1.8) -- (3.2, 3.5) -- (4.0, 2.8) -- (4.8, 4.0) -- (5.8, 3.2);
        \end{scope}
    \or% Case 6: AI & Computer Vision Spatial Intelligence
        \begin{scope}[opacity=0.28]
            \draw[cyberPurple, line width=1.1pt, fill=cyberPurple!20] (0.8, 1.2) rectangle (2.2, 4.2);
            \draw[spatialBlue, line width=1.1pt, fill=spatialBlue!25] (2.6, 1.6) rectangle (3.8, 3.8);
            \draw[openxrTeal, line width=1.1pt, fill=openxrTeal!30] (4.2, 2.0) rectangle (5.0, 3.4);
            \draw[-{Stealth[scale=0.9]}, white, line width=0.9pt] (2.2, 2.7) -- (2.6, 2.7);
            \draw[-{Stealth[scale=0.9]}, white, line width=0.9pt] (3.8, 2.7) -- (4.2, 2.7);
            \fill[emeraldActive] (5.8, 3.4) circle (3pt) node[right, font=\tiny\bfseries\color{emeraldActive}] {Grasp};
            \fill[amberGlow] (5.8, 2.7) circle (3pt) node[right, font=\tiny\bfseries\color{amberGlow}] {Pinch};
            \fill[cyan] (5.8, 2.0) circle (3pt) node[right, font=\tiny\bfseries\color{cyan}] {Point};
            \draw[white, line width=0.5pt] (5.0, 2.7) -- (5.8, 3.4);
            \draw[white, line width=0.5pt] (5.0, 2.7) -- (5.8, 2.7);
            \draw[white, line width=0.5pt] (5.0, 2.7) -- (5.8, 2.0);
        \end{scope}
    \or% Case 7: Advanced Virtual STEM Laboratory Frameworks
        \begin{scope}[opacity=0.28]
            \draw[white, line width=1.2pt] (0.6, 1.5) -- (6.2, 1.5);
            \draw[amberGlow, line width=1.4pt, fill=amberGlow!30] (0.8, 1.5) rectangle (1.4, 2.7);
            \draw[-{Stealth[scale=1.1]}, red!90!white, line width=1.6pt] (1.4, 2.1) -- (3.2, 2.1);
            \draw[cyan!80!white, line width=1.5pt, fill=cyan!30] (3.2, 2.1) ellipse (0.25cm and 1.2cm);
            \draw[red!90!white, line width=1.4pt] (3.2, 2.1) -- (5.0, 2.1);
            \draw[red!90!white, line width=1.4pt] (3.2, 2.7) -- (5.0, 2.1);
            \draw[red!90!white, line width=1.4pt] (3.2, 1.5) -- (5.0, 2.1);
            \fill[amberGlow] (5.0, 2.1) circle (3pt) node[below right, font=\tiny\bfseries\color{amberGlow}] {Focus};
            \draw[emeraldActive, line width=1.6pt] (5.8, 1.2) -- (5.8, 3.0);
        \end{scope}
    \else
        \begin{scope}[opacity=0.22]
            \draw[cyan!60!white, line width=0.5pt, step=0.6cm] (0.2, 0.2) grid (6.8, 5.2);
            \draw[amberGlow, line width=1.2pt] (3.4, 2.7) circle (1.8cm);
        \end{scope}
    \fi
}

% Chapter Banner Box
\newtcolorbox{chapterbannerbox}{
    enhanced,
    colback=darkNavy,
    colframe=openxrTeal,
    arc=4mm,
    boxrule=1.5pt,
    leftrule=6mm,
    top=12pt,
    bottom=12pt,
    left=16pt,
    right=16pt,
    shadow={3mm}{-3mm}{0mm}{black!70},
    underlay={%
        \begin{tcbclipinterior}
            \begin{scope}[shift={($(interior.south east)+(-6.8, 0.2)$)}]
                \renderchaptermotif
            \end{scope}
        \end{tcbclipinterior}
    }
}

\newcommand{\openxrchapterbanner}[1]{%
    \begin{chapterbannerbox}
        \raggedright
        {\color{amberGlow}\bfseries\large\chaptername\ \thechapter\par}
        \vspace{6pt}
        {\color{white}\bfseries\LARGE #1\par}
    \end{chapterbannerbox}
}

\newcommand{\openxrunnumberedchapterbanner}[1]{%
    \begin{chapterbannerbox}
        \raggedright
        {\color{white}\bfseries\LARGE #1\par}
    \end{chapterbannerbox}
}

% Title Formatting for Chapter (No top/bottom extra blank pages)
\titlespacing*{\chapter}{0pt}{0pt}{12pt}
\titleformat{\chapter}[block]
  {\normalfont}
  {}
  {0pt}
  {\openxrchapterbanner}
  [\global\setlength{\parindent}{1.25cm}]

\titleformat{name=\chapter,numberless}[block]
  {\normalfont}
  {}
  {0pt}
  {\openxrunnumberedchapterbanner}
  [\global\setlength{\parindent}{1.25cm}]

% Section & Subsection Formatting (RBRU Standards: Left 0cm / 1.25cm)
\titleformat{\section}
  {\normalfont\Large\bfseries\color{darkNavy}}
  {\makebox[1.25cm][l]{\thesection}}
  {0pt}
  {}
  [\global\setlength{\parindent}{1.25cm}]

\titleformat{name=\section,numberless}
  {\normalfont\Large\bfseries\color{darkNavy}}
  {}
  {0pt}
  {}
  [\global\setlength{\parindent}{1.25cm}]

\titlespacing*{\section}{0cm}{14pt plus 2pt minus 2pt}{6pt}

\titleformat{\subsection}
  {\normalfont\large\bfseries\color{spatialBlue}}
  {\makebox[1.25cm][l]{\thesubsection}}
  {0pt}
  {}
  [\global\setlength{\parindent}{2.50cm}]

\titleformat{name=\subsection,numberless}
  {\normalfont\large\bfseries\color{spatialBlue}}
  {}
  {0pt}
  {}
  [\global\setlength{\parindent}{2.50cm}]

\titlespacing*{\subsection}{1.25cm}{10pt plus 2pt minus 2pt}{4pt}

\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\color{openxrTeal}}
  {\makebox[1.0cm][l]{\thesubsubsection}}
  {0pt}
  {}
  [\global\setlength{\parindent}{3.75cm}]

\titleformat{name=\subsubsection,numberless}
  {\normalfont\normalsize\bfseries\color{openxrTeal}}
  {}
  {0pt}
  {}
  [\global\setlength{\parindent}{3.75cm}]

\titlespacing*{\subsubsection}{2.50cm}{8pt plus 2pt minus 2pt}{3pt}

% 6. Running Headers and Footers (fancyhdr) - Without Trailing Dots
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{darkSlate}\leftmark}
\fancyhead[R]{\small\color{darkSlate}\rightmark}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{\markboth{\chaptername\ \thechapter\quad #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\quad #1}}

\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[C]{\small\thepage}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}

