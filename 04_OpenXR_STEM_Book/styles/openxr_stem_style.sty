\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/openxr_stem_style}[2026/09/05 OpenXR and Spatial Computing for STEM Education Style — RBRU Masterclass]

% ============================================================
% 1. Page Geometry (มาตรฐาน มรภ.รำไพพรรณี)
% ============================================================
\RequirePackage{geometry}
\geometry{
    a4paper,
    top=1.5in,
    bottom=1.0in,
    left=1.5in,
    right=1.0in,
    headheight=43pt,
    headsep=12pt,
    footskip=0.5in
}

% 1.1 Thai Linebreak & Hyphenation for XeLaTeX
\XeTeXlinebreaklocale "th"
\XeTeXlinebreakskip = 0pt plus 2pt minus 0.5pt

% ป้องกัน orphan word ท้ายบรรทัด
\setlength{\emergencystretch}{2.5em}

% 1.2 Paragraph Indentation (มาตรฐาน มรภ.รำไพพรรณี: 1 Tab = 1.25cm)
\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{6pt plus 2pt minus 1pt}

% 1.3 Thai Academic Terminology (มาตรฐานระเบียบวิชาการ มรภ.รำไพพรรณี)
\renewcommand{\chaptername}{บทที่}
\renewcommand{\figurename}{ภาพที่}
\renewcommand{\tablename}{ตารางที่}
\renewcommand{\contentsname}{สารบัญ}
\renewcommand{\listfigurename}{สารบัญภาพ}
\renewcommand{\listtablename}{สารบัญตาราง}
\renewcommand{\appendixname}{ภาคผนวก}
\renewcommand{\bibname}{บรรณานุกรม}
\renewcommand{\indexname}{ดัชนีสืบค้นคำสำคัญ}

% ============================================================
% 2. Math & Science Packages
% ============================================================
\RequirePackage{amsmath,amssymb,amsfonts,mathtools}
\allowdisplaybreaks
\RequirePackage{bm}
\RequirePackage{siunitx}
\RequirePackage{physics}
\RequirePackage{esint}
\RequirePackage{enumitem}

% ============================================================
% 3. Graphics, TikZ, Tables & Floats
% ============================================================
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{colortbl}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}

\RequirePackage{caption}
\DeclareCaptionLabelSeparator{thaisep}{\quad}
\captionsetup{labelsep=thaisep}
\captionsetup[table]{position=top,  skip=6pt, labelfont={bf,color=spatialBlue}, textfont={normalfont}, labelsep=thaisep}
\captionsetup[figure]{position=bottom, skip=8pt, labelfont={bf,color=spatialBlue}, textfont={normalfont}, labelsep=thaisep}
\renewcommand{\thetable}{\thechapter.\arabic{table}}
\renewcommand{\thefigure}{\thechapter.\arabic{figure}}

% 3.1 Indexing System (ดัชนีสืบค้น 2 ภาษา)
\RequirePackage{imakeidx}
\makeindex[columns=2, title=ดัชนีสืบค้นคำสำคัญ, intoc]

\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows.meta,positioning,calc,patterns,decorations.pathmorphing,decorations.pathreplacing,3d}

% ============================================================
% 4. Color Palette (OpenXR Spatial Computing & STEM Aesthetic)
% ============================================================
\RequirePackage{xcolor}
\definecolor{openxrTeal}{HTML}{0D9488}       % Primary Teal / OpenXR Identity
\definecolor{spatialBlue}{HTML}{0284C7}       % Sky / Spatial Blue
\definecolor{cyberPurple}{HTML}{7C3AED}       % Purple / AI & Computation
\definecolor{darkNavy}{HTML}{0A1128}          % Dark Navy Background
\definecolor{emeraldActive}{HTML}{10B981}     % Emerald / Active States
\definecolor{amberGlow}{HTML}{F59E0B}         % Amber / Gold Accent
\definecolor{darkSlate}{HTML}{1E293B}         % Dark Slate
\definecolor{slateGrey}{HTML}{4A5568}         % Neutral Grey
\definecolor{codeBackground}{HTML}{0F172A}    % Code Background
\definecolor{rbruLightBg}{HTML}{F8FAFC}       % Light Background
\definecolor{rbruNavy}{HTML}{002B49}          % RBRU Navy
\definecolor{rbruGold}{HTML}{C5A059}          % RBRU Gold
\definecolor{openxrMint}{HTML}{CCFBF1}        % Mint Soft Background
\definecolor{openxrSoftBg}{HTML}{F0FDFA}      % Pale Teal Background

% ============================================================
% 5. Section & Chapter Formatting (ตาม Microbiology Style)
% ============================================================
\RequirePackage[most]{tcolorbox}
\RequirePackage{titlesec}
\RequirePackage{setspace}
\setstretch{1.2}

% กล่องหัวบทวิชาการ OpenXR (Chapter Banner Box — ชิดขวา เหมือน Microbiology)
\newtcolorbox{chapterbannerbox}{
    enhanced,
    width=\textwidth,
    arc=6pt,
    boxrule=1pt,
    colframe=openxrTeal!90!black,
    interior style={left color=darkNavy!98!black, right color=darkNavy!85!darkSlate},
    colback=darkNavy,
    borderline east={4pt}{0pt}{amberGlow},
    top=16pt, bottom=16pt, left=16pt, right=20pt,
    drop shadow=black!15,
    underlay={
        \begin{tcbclipinterior}
            \begin{scope}[opacity=0.20]
                % กริดเชิงพื้นที่ (Spatial Grid Motif)
                \draw[openxrTeal!60!white, line width=0.4pt, step=0.5cm] (0.2, 0.2) grid (6.8, 5.0);
                % แกนพิกัด XYZ
                \draw[-{Stealth[scale=1.1]}, cyan!70!white, line width=1.2pt] (0.8, 0.8) -- (5.0, 0.8);
                \draw[-{Stealth[scale=1.1]}, emeraldActive!80!white, line width=1.2pt] (0.8, 0.8) -- (0.8, 4.5);
                \draw[-{Stealth[scale=1.1]}, amberGlow!80!white, line width=1.2pt] (0.8, 0.8) -- (0.2, 0.2);
                % วงรีวงโคจร 6DoF
                \draw[cyberPurple!70!white, line width=1.0pt] (3.5, 2.8) ellipse (2.0cm and 0.7cm);
                \draw[spatialBlue!70!white, line width=1.0pt, rotate around={60:(3.5,2.8)}] (3.5, 2.8) ellipse (2.0cm and 0.7cm);
            \end{scope}
        \end{tcbclipinterior}
    }
}

% รูปแบบหัวบท (ชิดขวา เหมือน microbiology_style)
\newcommand{\openxrchapterbanner}[1]{%
    \begin{chapterbannerbox}
        \raggedleft
        {\fontsize{44}{50}\selectfont\bfseries\color{white} \chaptername\ \thechapter\par}
        \vspace{6pt}
        {\color{amberGlow}\rule{0.50\textwidth}{2pt}\par}
        \vspace{6pt}
        {\fontsize{25}{31}\selectfont\bfseries\color{white} #1\par}
    \end{chapterbannerbox}
}

\newcommand{\openxrunnumberedchapterbanner}[1]{%
    \begin{chapterbannerbox}
        \raggedleft
        \vspace{4pt}
        {\fontsize{28}{34}\selectfont\bfseries\color{white} #1\par}
        \vspace{4pt}
    \end{chapterbannerbox}
}

\titleformat{\chapter}[block]
  {\normalfont}
  {}
  {0pt}
  {\openxrchapterbanner}

\titleformat{name=\chapter,numberless}[block]
  {\normalfont}
  {}
  {0pt}
  {\openxrunnumberedchapterbanner}

\titlespacing*{\chapter}{0pt}{-20pt}{20pt}

% การจัดรูปแบบ Section และ Subsection (ตาม microbiology_style: fontsize + makebox)
\titleformat{\section}
    {\fontsize{18}{22}\bfseries\color{spatialBlue}}
    {\makebox[1.25cm][l]{\thesection}}
    {0pt}
    {}
\titleformat{name=\section,numberless}
    {\fontsize{18}{22}\bfseries\color{spatialBlue}}
    {}
    {0pt}
    {}
\titlespacing{\section}{0pt}{16pt}{8pt}

\titleformat{\subsection}
    {\fontsize{15}{18}\bfseries\color{openxrTeal}}
    {\makebox[1.25cm][l]{\thesubsection}}
    {0pt}
    {}
\titleformat{name=\subsection,numberless}
    {\fontsize{15}{18}\bfseries\color{openxrTeal}}
    {}
    {0pt}
    {}
\titlespacing{\subsection}{0pt}{12pt}{6pt}

\titleformat{\subsubsection}
    {\fontsize{13}{16}\bfseries\color{cyberPurple}}
    {\makebox[1.25cm][l]{\thesubsubsection}}
    {0pt}
    {}
\titleformat{name=\subsubsection,numberless}
    {\fontsize{13}{16}\bfseries\color{cyberPurple}}
    {}
    {0pt}
    {}
\titlespacing{\subsubsection}{0pt}{10pt}{4pt}

% ============================================================
% 6. Running Headers & Footers (fancyhdr — ตาม Microbiology)
% ============================================================
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{openxrTeal}\leaders\hrule height \headrulewidth\hfill}}

\fancyhead[LE]{\small\bfseries\color{openxrTeal} \thepage \quad \textbar \quad OpenXR และการประมวลผลเชิงพื้นที่เพื่อสะเต็มศึกษา}
\fancyhead[RO]{\small\bfseries\color{openxrTeal} \leftmark \quad \textbar \quad \thepage}
\fancyfoot[C]{\small\color{slateGrey} มหาวิทยาลัยราชภัฏรำไพพรรณี}

% Custom Chapter Mark ไม่มีจุดปะ
\renewcommand{\chaptermark}[1]{%
    \markboth{%
        \ifnum \c@secnumdepth >\m@ne
            \if@mainmatter
                \chaptertitlename\ \thechapter\quad
            \fi
        \fi
        #1%
    }{}%
}

\fancypagestyle{plain}{
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \fancyfoot[C]{\small\bfseries\color{openxrTeal} \thepage}
}

