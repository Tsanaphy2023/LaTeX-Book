\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/openxr_stem_style}[2026/09/05 OpenXR and Spatial Computing for STEM Education Style]

% 1. Page Geometry (RBRU Standard: Left 1.5in, Top 1.5in, Right 1.0in, Bottom 1.0in)
\RequirePackage{geometry}
\geometry{
    a4paper,
    top=1.5in,
    bottom=1.0in,
    left=1.5in,
    right=1.0in,
    headheight=36pt,
    headsep=12pt,
    footskip=0.5in
}

% 1.1 Thai Linebreak & Hyphenation for XeLaTeX
\XeTeXlinebreaklocale "th"
\XeTeXlinebreakskip = 0pt plus 2pt minus 0.5pt
\setlength{\emergencystretch}{2.5em}

% 1.2 Paragraph Indentation (RBRU Standard: 1 Tab = 1.25cm)
\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{4pt plus 1pt minus 1pt}

% 1.3 Thai Academic Terminology
\renewcommand{\chaptername}{บทที่}
\renewcommand{\figurename}{ภาพที่}
\renewcommand{\tablename}{ตารางที่}
\renewcommand{\contentsname}{สารบัญ}
\renewcommand{\listfigurename}{สารบัญภาพ}
\renewcommand{\listtablename}{สารบัญตาราง}
\renewcommand{\appendixname}{ภาคผนวก}
\renewcommand{\bibname}{บรรณานุกรม}
\renewcommand{\indexname}{ดัชนีสืบค้นคำสำคัญ}

% 2. Math & Physics Packages
\RequirePackage{amsmath,amssymb,amsfonts,mathtools}
\allowdisplaybreaks
\RequirePackage{bm}
\RequirePackage{siunitx}
\RequirePackage{physics}
\RequirePackage{esint}
\RequirePackage{enumitem}

% 3. Graphics, TikZ, Tables & Floats
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{colortbl}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}
\RequirePackage{caption}
\DeclareCaptionLabelSeparator{thaisep}{\quad}
\captionsetup{labelsep=thaisep}
\captionsetup[table]{position=top, skip=6pt, labelfont={bf,color=darkNavy}, textfont={normalfont}, labelsep=thaisep}
\captionsetup[figure]{position=bottom, skip=8pt, labelfont={bf,color=darkNavy}, textfont={normalfont}, labelsep=thaisep}
\renewcommand{\thetable}{\thechapter.\arabic{table}}
\renewcommand{\thefigure}{\thechapter.\arabic{figure}}

% 3.1 Indexing System
\RequirePackage{imakeidx}
\makeindex[columns=2, title=ดัชนีสืบค้นคำสำคัญ, intoc]

\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows.meta,positioning,calc,patterns,decorations.pathmorphing,decorations.pathreplacing,3d}

