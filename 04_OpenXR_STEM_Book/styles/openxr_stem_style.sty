% 7.6 กล่องโค้ด Python / AI Prompt (Code Box)
\RequirePackage{listings}
\definecolor{codeKw}{HTML}{7C3AED}
\definecolor{codeStr}{HTML}{0D9488}
\definecolor{codeCom}{HTML}{64748B}

\lstdefinestyle{openxrcode}{
    language=Python,
    backgroundcolor=\color{codeBackground},
    basicstyle=\ttfamily\footnotesize\color{white},
    keywordstyle=\bfseries\color{amberGlow},
    stringstyle=\color{emeraldActive},
    commentstyle=\itshape\color{codeCom},
    numbers=left,
    numberstyle=\tiny\color{slateGrey},
    stepnumber=1,
    numbersep=8pt,
    frame=none,
    breaklines=true,
    breakatwhitespace=false,
    showstringspaces=false,
    tabsize=4
}

\newtcblisting{codebox}[1][การประมวลผลโค้ดคำสั่ง]{
    enhanced,
    breakable,
    colback=codeBackground,
    colframe=darkSlate,
    colbacktitle=darkSlate,
    coltitle=amberGlow,
    fonttitle=\bfseries\small,
    title={#1},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=3.5mm,
    pad at break=2mm,
    listing only,
    listing style=openxrcode
}

