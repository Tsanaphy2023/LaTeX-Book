\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/rbru_book_style}[2026/09/04 RBRU Academic Textbook & Physics Layout Standard Style]

% 1. Page Geometry (มาตรฐาน มรภ.รำไพพรรณี: ซ้าย 1.5 นิ้ว, บน 1.5 นิ้ว, ขวา 1 นิ้ว, ล่าง 1 นิ้ว)
\RequirePackage{geometry}
\geometry{
    a4paper,
    top=1.5in,
    bottom=1.0in,
    left=1.5in,
    right=1.0in,
    headheight=36pt,
    headsep=12pt,
    footskip=0.5in
}

% 1.1 Thai Linebreak & Hyphenation for XeLaTeX
\XeTeXlinebreaklocale "th"
\XeTeXlinebreakskip = 0pt plus 2pt minus 0.5pt

% ป้องกัน overfull hbox และ orphan word ในตำราฟิสิกส์คณิตศาสตร์
\setlength{\emergencystretch}{2.5em}

% 1.3 Paragraph Indentation (มาตรฐาน มรภ.รำไพพรรณี: 1 Tab = 1.25cm)
\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{4pt plus 1pt minus 1pt}

% 1.2 Thai Academic Terminology (มาตรฐานระเบียบวิชาการ มรภ.รำไพพรรณี)
\renewcommand{\chaptername}{บทที่}
\renewcommand{\figurename}{ภาพที่}
\renewcommand{\tablename}{ตารางที่}
\renewcommand{\contentsname}{สารบัญ}
\renewcommand{\listfigurename}{สารบัญภาพ}
\renewcommand{\listtablename}{สารบัญตาราง}
\renewcommand{\appendixname}{ภาคผนวก}
\renewcommand{\bibname}{บรรณานุกรม}
\renewcommand{\indexname}{ดัชนีสืบค้นคำสำคัญ}

% 2. Math & Science Packages (Physics Textbook Architect)
\RequirePackage{amsmath,amssymb,amsfonts,mathtools}
\allowdisplaybreaks  % อนุญาตให้ equation ยาวข้ามหน้าได้
\RequirePackage{bm}
\RequirePackage{siunitx}
\RequirePackage{physics}
\RequirePackage{esint}

% 3. Graphics, TikZ, Tables & Floats
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{colortbl}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}
\RequirePackage{caption}
\DeclareCaptionLabelSeparator{thaisep}{\quad}
\captionsetup{labelsep=thaisep}
\captionsetup[table]{position=top, skip=6pt, labelfont={bf,color=rbruNavy}, textfont={normalfont}, labelsep=thaisep}
\captionsetup[figure]{position=bottom, skip=8pt, labelfont={bf,color=rbruNavy}, textfont={normalfont}, labelsep=thaisep}
\renewcommand{\thetable}{\thechapter.\arabic{table}}

% 3.1 Indexing System (ดัชนีสืบค้น 2 ภาษา)
\RequirePackage{imakeidx}
\makeindex[columns=2, title=ดัชนีสืบค้นคำสำคัญ, intoc]

\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows.meta,positioning,calc,patterns,decorations.pathmorphing}

