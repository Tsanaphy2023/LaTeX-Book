\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/envi_biomass_style}[2026/09/05 RBRU Environmental Physics, PM2.5 and Biomass Energy Style Standard]

% ============================================================
% 1. Page Geometry (มาตรฐาน มรภ.รำไพพรรณี)
% ============================================================
\RequirePackage{geometry}
\geometry{
    a4paper,
    top=1.5in,
    bottom=1.0in,
    left=1.5in,
    right=1.0in,
    headheight=38pt,
    headsep=14pt,
    footskip=0.5in
}

% 1.1 Thai Linebreak & Hyphenation for XeLaTeX
\XeTeXlinebreaklocale "th"
\XeTeXlinebreakskip = 0pt plus 2pt minus 0.5pt
\setlength{\emergencystretch}{2.5em}

% 1.2 Paragraph Indentation (มาตรฐาน มรภ.รำไพพรรณี: 1 Tab = 1.25cm)
\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{6pt plus 2pt minus 1pt}

% 1.3 Thai Academic Terminology
\renewcommand{\chaptername}{บทที่}
\renewcommand{\figurename}{ภาพที่}
\renewcommand{\tablename}{ตารางที่}
\renewcommand{\contentsname}{สารบัญ}
\renewcommand{\listfigurename}{สารบัญภาพ}
\renewcommand{\listtablename}{สารบัญตาราง}
\renewcommand{\appendixname}{ภาคผนวก}
\renewcommand{\bibname}{บรรณานุกรม}
\renewcommand{\indexname}{ดัชนีสืบค้นคำสำคัญ}

% ============================================================
% 2. Math & Science Packages
% ============================================================
\RequirePackage{amsmath,amssymb,amsfonts,mathtools}
\RequirePackage{bm}
\RequirePackage{siunitx}

% ============================================================
% 3. Graphics, Tables, & Floats
% ============================================================
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{colortbl}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}

\RequirePackage{caption}
\DeclareCaptionLabelSeparator{thaisep}{\quad}
\captionsetup{labelsep=thaisep}
\captionsetup[table]{position=top, skip=6pt, labelfont={bf,color=carbonNavy}, textfont={normalfont}, labelsep=thaisep}
\captionsetup[figure]{position=bottom, skip=8pt, labelfont={bf,color=carbonNavy}, textfont={normalfont}, labelsep=thaisep}

% ============================================================
% 4. Color Palette (Atmospheric Physics, PM2.5, Clean Energy, Biomass)
% ============================================================
\RequirePackage[table,xcdraw]{xcolor}
\definecolor{carbonNavy}{HTML}{0F172A}
\definecolor{skyBlue}{HTML}{0284C7}
\definecolor{flameAmber}{HTML}{EA580C}
\definecolor{biomassBrown}{HTML}{78350F}
\definecolor{cleanGreen}{HTML}{059669}
\definecolor{tverGold}{HTML}{D97706}
\definecolor{charcoal}{HTML}{1E293B}
\definecolor{slateGrey}{HTML}{475569}
\definecolor{softSmoke}{HTML}{F8FAFC}

% ============================================================
% 5. TikZ & Vector Graphics
% ============================================================
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, calc, shadows, backgrounds, fit, patterns, decorations.pathmorphing}

% ============================================================
% 6. Custom Highlight Boxes (tcolorbox)
% ============================================================
\RequirePackage[most]{tcolorbox}

% 6.1 Concept Box (มโนทัศน์ฟิสิกส์สิ่งแวดล้อม)
\newtcolorbox{conceptbox}[1][]{
    enhanced,
    colback=softSmoke,
    colframe=skyBlue,
    coltitle=white,
    fonttitle=\bfseries\normalsize,
    title={#1},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm,
    top=8pt, bottom=8pt, left=10pt, right=10pt,
    before skip=10pt, after skip=10pt,
    drop shadow={black!20}
}

% 6.2 Physics Formula & Optics Box (สมการและฟิสิกส์การกระเจิงแสง)
\newtcolorbox{physbox}[1][หลักการฟิสิกส์และแบบจำลองทัศนศาสตร์]{
    enhanced,
    colback=carbonNavy!5!white,
    colframe=carbonNavy,
    coltitle=white,
    fonttitle=\bfseries\normalsize,
    title={#1},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm,
    top=8pt, bottom=8pt, left=10pt, right=10pt,
    before skip=10pt, after skip=10pt,
    drop shadow={black!20}
}

% 6.3 Biomass & Combustion Box (พลังงานชีวมวลและการเผาไหม้)
\newtcolorbox{flamebox}[1][นวัตกรรมเชื้อเพลิงชีวมวลและพลังงานความร้อน]{
    enhanced,
    colback=flameAmber!8!white,
    colframe=flameAmber,
    coltitle=white,
    fonttitle=\bfseries\normalsize,
    title={#1},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm,
    top=8pt, bottom=8pt, left=10pt, right=10pt,
    before skip=10pt, after skip=10pt,
    drop shadow={black!20}
}

% 6.4 Case Study & Carbon Credits Box (กรณีศึกษาและการลดคาร์บอน T-VER)
\newtcolorbox{casebox}[1][กรณีศึกษาวิจัยและกลไกคาร์บอนเครดิต T-VER]{
    enhanced,
    colback=cleanGreen!8!white,
    colframe=cleanGreen,
    coltitle=white,
    fonttitle=\bfseries\normalsize,
    title={#1},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm,
    top=8pt, bottom=8pt, left=10pt, right=10pt,
    before skip=10pt, after skip=10pt,
    drop shadow={black!20}
}

% ============================================================
% 7. Section & Chapter Headings (มาตรฐาน มรภ.รำไพพรรณี)
% ============================================================
\RequirePackage{titlesec}
\RequirePackage{needspace}

% 7.1 Chapter Format
\titleformat{\chapter}[display]
    {\normalfont\Huge\bfseries\color{carbonNavy}}
    {\flushleft\Large\bfseries\color{flameAmber}\chaptername\ \thechapter}
    {8pt}
    {\Huge\bfseries}
    [\vspace{8pt}\color{flameAmber}\rule{\textwidth}{1.5pt}\vspace{10pt}]

\titlespacing*{\chapter}{0pt}{*2}{*3}

% 7.2 Section Format
\titleformat{\section}
    {\normalfont\Large\bfseries\color{carbonNavy}}
    {\makebox[1.25cm][l]{\thesection}}
    {0pt}
    {}

\titlespacing*{\section}{0pt}{14pt plus 3pt minus 2pt}{6pt plus 1pt minus 1pt}

% 7.3 Subsection Format (ย่อหน้า 1.25cm)
\titleformat{\subsection}
    {\normalfont\large\bfseries\color{skyBlue}}
    {\makebox[1.25cm][l]{\thesubsection}}
    {0pt}
    {}

\titlespacing*{\subsection}{1.25cm}{10pt plus 2pt minus 2pt}{4pt plus 1pt minus 1pt}

% 7.4 Subsubsection Format (ย่อหน้า 2.50cm)
\titleformat{\subsubsection}
    {\normalfont\normalsize\bfseries\color{flameAmber}}
    {\makebox[1.25cm][l]{\thesubsubsection}}
    {0pt}
    {}

\titlespacing*{\subsubsection}{2.50cm}{8pt plus 2pt minus 1pt}{3pt plus 1pt minus 1pt}

% ============================================================
% 8. Running Headers & Footers (fancyhdr)
% ============================================================
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{skyBlue}\leaders\hrule height \headrulewidth\hfill}}

\fancyhead[LE]{\small\bfseries\color{skyBlue} \thepage \quad \textbar \quad ฟิสิกส์สิ่งแวดล้อม การตรวจวัด PM2.5 และนวัตกรรมพลังงานชีวมวล}
\fancyhead[RO]{\small\bfseries\color{skyBlue} \leftmark \quad \textbar \quad \thepage}
\fancyfoot[C]{\small\color{slateGrey} มหาวิทยาลัยราชภัฏรำไพพรรณี}

\renewcommand{\chaptermark}[1]{%
    \markboth{%
        \ifnum \c@secnumdepth >\m@ne
            \if@mainmatter
                \chaptertitlename\ \thechapter\quad
            \fi
        \fi
        #1}{}%
}

% ============================================================
% 9. Listings & Indexing
% ============================================================
\RequirePackage{listings}
\lstset{
    basicstyle=\small\ttfamily,
    breaklines=true,
    frame=single,
    backgroundcolor=\color{softSmoke},
    rulecolor=\color{slateGrey!40},
    numbers=left,
    numberstyle=\tiny\color{slateGrey},
    tabsize=2
}

\RequirePackage{makeidx}
\makeindex

\endinput
